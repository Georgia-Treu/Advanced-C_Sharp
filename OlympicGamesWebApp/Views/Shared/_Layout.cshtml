@using OlympicGamesWebApp.Models

@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OlympicGamesWebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OlympicGamesWebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="text-center">
        <h1 class="bg-primary text-white mt-3 p-3">
            Olympic Games Web App
        </h1>
        @if (TempData.Keys.Contains("message"))
            {
                <h4 class="bg-success text-white p-2">
                    @TempData["message"]
                </h4>
            }

            @if (controller != "Favorites")
            {
                var session = new OlympicSession(Context.Session);
                int? count = session.GetFavoriteCount();

                @if (count.HasValue)
                {
                    <h5 class="bg-info p-2">
                        <a asp-controller="Favorites" asp-action="Index" class="text-white text-decoration-none">
                            My Favorite Countries
                        </a>
                        <span class="badge bg-light text-dark">
                            @count
                        </span>
                    </h5>
                }
            }
            <nav class="navbar navbar-expand-sm navbar-light bg-light border-bottom mb-3">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        OlympicGamesWebApp
                    </a>
                    <div class="navbar-collapse collapse show">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    Home
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header> 
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OlympicGamesWebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
